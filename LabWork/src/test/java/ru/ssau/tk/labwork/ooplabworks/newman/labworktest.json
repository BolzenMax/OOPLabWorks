{
  "info": {
    "name": "LabWork Complete API Tests",
    "description": "Complete API test suite for LabWork application - All endpoints covered",
    "version": "1.0.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminAuth",
      "value": "Basic YWRtaW46YWRtaW4=",
      "type": "string"
    },
    {
      "key": "testUserAuth",
      "value": "Basic dGVzdHVzZXI6dGVzdHBhc3M=",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "functionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pointId",
      "value": "",
      "type": "string"
    },
    {
      "key": "newUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "timestamp",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔄 Setup - Generate Timestamp",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const timestamp = new Date().getTime();",
              "pm.collectionVariables.set('timestamp', timestamp);",
              "console.log('Test run timestamp:', timestamp);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "1. 🔐 Authentication Tests",
      "item": [
        {
          "name": "1.1 Auth - User Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Registration handled correctly\", function () {",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData).to.have.property('id');",
                  "        pm.expect(jsonData.login).to.equal('testuser_' + pm.collectionVariables.get('timestamp'));",
                  "    } else if (pm.response.code === 400) {",
                  "        var responseText = pm.response.text();",
                  "        pm.expect(responseText).to.include('уже существует');",
                  "    } else {",
                  "        pm.expect.fail('Unexpected status code: ' + pm.response.code);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"testuser_{{timestamp}}\",\n  \"password\": \"testpass\",\n  \"role\": \"CIVIL\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "1.2 Auth - Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Admin login successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.login).to.equal('admin');",
                  "    pm.expect(jsonData.role).to.equal('ADMIN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. 👥 Users Management Tests",
      "item": [
        {
          "name": "2.1 Users - Create New User (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User created successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.login).to.equal('newuser_' + pm.collectionVariables.get('timestamp'));",
                  "    pm.expect(jsonData.role).to.equal('CIVIL');",
                  "    pm.collectionVariables.set('newUserId', jsonData.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"newuser_{{timestamp}}\",\n  \"password\": \"newpassword\",\n  \"role\": \"CIVIL\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "2.2 Users - Get User by ID (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User data is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var expectedUserId = parseInt(pm.collectionVariables.get('newUserId'));",
                  "    pm.expect(jsonData.id).to.equal(expectedUserId);",
                  "    pm.expect(jsonData.login).to.equal('newuser_' + pm.collectionVariables.get('timestamp'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{newUserId}}"
          }
        },
        {
          "name": "2.3 Users - Update User (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"User updated successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.login).to.equal('updateduser_' + pm.collectionVariables.get('timestamp'));",
                  "    pm.expect(jsonData.role).to.equal('CIVIL');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"updateduser_{{timestamp}}\",\n  \"password\": \"newpassword123\",\n  \"role\": \"CIVIL\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/users/{{newUserId}}"
          }
        },
        {
          "name": "2.4 Users - Get All Users (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "pm.test(\"Contains users\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var logins = jsonData.map(user => user.login);",
                  "    pm.expect(logins).to.include('admin');",
                  "    pm.expect(logins).to.include('testuser');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{adminAuth}}"
              }
            ],
            "url": "{{baseUrl}}/api/users"
          }
        }
      ]
    },
    {
      "name": "3. 📊 Functions Management Tests",
