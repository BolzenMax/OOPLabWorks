{
  "info": {
    "name": "LabWork — Security Tests (CIVIL/ADMIN)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": " GET /api/users — no auth → 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Error message contains 'Basic Auth'\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.error).to.include(\"Basic Auth\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": " GET /api/users — invalid creds → 401",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic dGVzdDp3cm9uZw=="
          }
        ],
        "url": "{{base_url}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "🛡 GET /api/users — CIVIL → 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{civilAuth}}"
          }
        ],
        "url": "{{base_url}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 403\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "pm.test(\"Error message contains 'ADMIN'\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json.error).to.include(\"ADMIN\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": " GET /api/users — ADMIN → 200 (array)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Basic {{adminAuth}}"
          }
        ],
        "url": "{{base_url}}/api/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is array\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": " POST /api/points — no auth → 401",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"functionId\": 1,\n  \"x\": 1.0,\n  \"y\": 1.0\n}"
        },
        "url": "{{base_url}}/api/points"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },

    {
      "name": "🛡 POST /api/points — CIVIL, foreign function → 403 (if enforced in RoleFilter) or 400/404",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Basic {{civilAuth}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"functionId\": 1,\n  \"x\": 1.0,\n  \"y\": 1.0\n}"
        },
        "url": "{{base_url}}/api/points"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 403 or 400/404\", function () {",
              "    var code = pm.response.code;",
              "    pm.expect(code === 403 || code === 400 || code === 404).to.be.true;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": " GET /api/functions?userId=SELF — CIVIL → 200 (array)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Basic {{civilAuth}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/functions?userId={{civilUserId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "functions"],
          "query": [
            { "key": "userId", "value": "{{civilUserId}}" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is array\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "🛡 GET /api/functions?userId=OTHER — CIVIL → 403",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Basic {{civilAuth}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/functions?userId={{adminUserId}}",
          "host": ["{{base_url}}"],
          "path": ["api", "functions"],
          "query": [
            { "key": "userId", "value": "{{adminUserId}}" }
          ]
        }
      },
      "event": [
