    {
      "name": "User API Tests",
      "item": [
        {
          "name": "POST /api/users — Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response is JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Contains required fields\", function () {",
                  "    pm.expect(json).to.have.property('id');",
                  "    pm.expect(json).to.have.property('login');",
                  "    pm.expect(json).to.have.property('role');",
                  "    pm.expect(json).to.have.property('enabled');",
                                    "});",
                  "",
                  "pm.test(\"Field types are correct\", function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.login).to.be.a('string');",
                  "    pm.expect(json.role).to.be.a('string');",
                  "    pm.expect(json.enabled).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test(\"Values match input\", function () {",
                  "    pm.expect(json.login).to.eql('testuser');",
                  "    pm.expect(json.role).to.eql('CIVIL');",
                  "    pm.expect(json.enabled).to.be.true;",
                  "});",
                  "",
                  "pm.environment.set('createdUserId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"testuser\",\n  \"role\": \"CIVIL\",\n  \"password\": \"123456\",\n  \"enabled\": true\n}"
            },
