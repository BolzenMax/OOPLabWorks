    {
      "name": "Point API Tests",
      "item": [
        {
          "name": "🔧 Ensure Function Exists",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const baseUrl = pm.variables.get('base_url');",
                  "",
                  "// 1. Create user",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/api/users',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            login: 'point_tester',",
                  "            role: 'CIVIL',",
                  "            password: '123',",
                  "            enabled: true",
                  "        })",
                  "    }",
                  "}, (err, res) => {",
                  "    if (err || res.code !== 201) {",
                  "        console.error('User creation failed:', res ? res.code : err);",
                  "        return;",
                  "    }",
                  "    const userId = res.json().id;",
                  "    pm.environment.set('point_test_userId', userId);",
                  "",
                  "    // 2. Create function",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/api/functions',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                userId: userId,",
                  "                name: 'test_func',",
                  "                signature: 'f(x)='",
                  "            })",
                  "        }",
                  "    }, (err2, res2) => {",
                  "        if (err2 || res2.code !== 201) {",
                  "            console.error('Function creation failed:', res2 ? res2.code : err2);",
                  "            return;",
                  "        }",
                  "        const funcId = res2.json().id;",
                  "        pm.environment.set('point_test_functionId', funcId);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/points"
          }
        },
        {
          "name": "POST /api/points — Create Point",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Valid JSON\", () => pm.response.to.be.json);",
                  "const p = pm.response.json();",
                  "pm.expect(p.functionId).to.eql(pm.environment.get('point_test_functionId'));",
                  "pm.environment.set('createdPointId', p.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"functionId\": {{point_test_functionId}},\n  \"x\": 1.0,\n  \"y\": 2.0\n}"
            },
            "url": "{{base_url}}/api/points"
          }
        },
        {
          "name": "GET /api/points/{{createdPointId}}",
          "event": [{ "listen": "test", "script": { "exec": [ "pm.test(\"Status 200\", () => pm.response.to.have.status(200));" ], "type": "text/javascript" } }],
          "request": { "method": "GET", "url": "{{base_url}}/api/points/{{createdPointId}}" }
        },
        {
          "name": "Cleanup Point Test Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Delete point",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('base_url') + '/api/points/' + pm.environment.get('createdPointId'),",
                  "    method: 'DELETE'",
                  "});",
                  "",
                  "// Delete function",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('base_url') + '/api/functions/' + pm.environment.get('point_test_functionId'),",
                  "    method: 'DELETE'",
                  "});",
                  "",
                  "// Delete user",
                  "pm.sendRequest({",
                  "    url: pm.variables.get('base_url') + '/api/users/' + pm.environment.get('point_test_userId'),",
                  "    method: 'DELETE'",
                  "});",
                  "",
                  "pm.environment.unset('point_test_userId');",
                  "pm.environment.unset('point_test_functionId');",
                  "pm.environment.unset('createdPointId');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/points"
          }
        }
      ]
    }
  ]
}